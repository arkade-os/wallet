# wallet arkade-regtest overrides
# NOTE: don't pin FULMINE_IMAGE here — the arkade-regtest stack's compose tracks
# the matching Fulmine env-var contract (FULMINE_DELEGATE_*), so an out-of-date
# pin (e.g. v0.3.23, which only reads FULMINE_DELEGATOR_*) silently breaks the
# delegator. Use the submodule's default Fulmine image.

# Match wallet's existing arkd config
ARKD_SCHEDULER_TYPE=gocron
ARKD_SESSION_DURATION=10
ARKD_ROUND_INTERVAL=3
ARKD_LOG_LEVEL=6

# The RFQ swap covenant needs an exit delay it can express as a BIP68 relative
# timelock, whose unit is 512 seconds. The stack's default of 5 is BELOW one
# unit, and both sides of a swap refuse it outright rather than round a
# sub-unit value into a real timelock: the wallet's client throws "server exit
# delay must be at least 512s", the solver's "5 is below 512s and is a block
# count, not seconds". Lightning send therefore cannot run at all on the
# default regtest config. 1024s = 2 units, leaving room for the solver's
# refund delays, which step one unit above the claim delay each.
#
# 512 is also where arkd switches a delay's UNIT: below it a value is a block
# count, at or above it a number of seconds. arkd refuses a config that mixes
# the two ("all delays must be above or below value 512"), so raising the
# unilateral delay alone leaves it dead on startup — every delay below has to
# cross over with it. The remaining constraints it enforces: boarding must
# differ from unilateral, and public unilateral must be >= unilateral.
ARKD_VTXO_TREE_EXPIRY=86400
ARKD_UNILATERAL_EXIT_DELAY=3072
ARKD_PUBLIC_UNILATERAL_EXIT_DELAY=3072
ARKD_BOARDING_EXIT_DELAY=4096
ARKD_CHECKPOINT_EXIT_DELAY=2048

# Zero fees - faucetOffchain uses wallet.settle() without fee budget
ARK_OFFCHAIN_INPUT_FEE="0.0"
ARK_ONCHAIN_INPUT_FEE="0.0"
ARK_OFFCHAIN_OUTPUT_FEE="0.0"
ARK_ONCHAIN_OUTPUT_FEE="0.0"

AUTOMINE_INTERVAL=60