  "source": {
    "entry": "attestation_beacon.ark",
    "files": {
      "attestation_beacon.ark": "pragma arkade ^0.1.0;\n\n// AttestationBeacon: a price registry that other covenants read by spending\n// it in the same transaction.\n//\n// A fixing is one DIA OracleUpdate for BTC/USD, co-authorized by the oracle\n// service's adminPk so only the canonical fixing for each 5-minute close can be\n// recorded while DIA's EIP-712 signature prevents the oracle from inventing prices.\n// Close times must sit on the 5-minute grid and strictly advance so old closes\n// cannot be flushed and overwritten.\n//\n// State is the extension packet of type STATE, 329 bytes:\n//   0        version, 0x01\n//   1..9     round, int2bytes(round, 8)\n//   9..329   8 slots of 40 bytes, newest first: expiry int2bytes(expiry, 8), value 32 bytes\n// The value keeps the cents in the first 8 bytes. The next 8 are the sample\n// time. The rest are zero.\n\ncontract AttestationBeacon(\n  bytes32 ctrlTxid,\n  int ctrlGidx,\n  bytes domain,\n  int expiryLag,\n  int readFee,\n  pubkey adminPk,\n  int exit\n) {\n  const int STATE = 32;\n  const int SIZE = 329;\n  const int SLOTS = 9;\n  const int VALUE_AT = 17;\n  const int HISTORY_AT = 49;\n  const int HISTORY = 280;\n  const int GRID = 300;\n  const int PRICE_MAX = 1000000000;\n  const int SCALE = 10000000000000000;\n  const int HALF = 5000000000000000;\n\n  private function continues(bytes state) {\n    require(size(state) == SIZE, \"state size\");\n    require(substr(state, 0, 1) == 0x01, \"state version\");\n    require(tx.outputs[0].script == tx.input.current.script, \"script\");\n    require(tx.outputs[0].assets.lookup(AssetId { txid: ctrlTxid, gidx: ctrlGidx }) == 1, \"identity asset\");\n  }\n\n  private function absent(bytes prev, int expiry) {\n    int[8] slots = [9, 49, 89, 129, 169, 209, 249, 289];\n    for (i, offset) in slots {\n      require(substr(prev, offset, 8) != int2bytes(expiry, 8), \"expiry already in a slot\");\n    }\n  }\n\n  private function word(int n) bytes {\n    return reverseBytes(int2bytes(n, 32));\n  }\n\n  @allow(unsigned-spend-path, \"authorized by both pinned DIA EIP-712 signature and oracle adminPk\")\n  function attest(int expiry, int price, int time, int nonce, int intentExpiry, signature sig, signature adminSig) {\n    require(this.activeInputIndex == 0, \"beacon is input 0\");\n    require(expiry > 1800, \"expiry\");\n    require(expiry % GRID == 0, \"expiry grid\");\n    if (expiryLag >= 0) {\n      require(checkTime(expiry + expiryLag), \"before expiry time\");\n    }\n    require(price > 0, \"nonpositive price\");\n    require(time >= expiry, \"sample before expiry\");\n    require(time <= expiry + expiryLag, \"sample after close\");\n\n    int q = price / SCALE;\n    int r = price % SCALE;\n    int cents = q;\n    if (r >= HALF) {\n      cents = q + 1;\n    }\n    require(cents > 0, \"price\");\n    require(cents <= PRICE_MAX, \"price cap\");\n\n    bytes body = 0x24e574fa7512cc24e9109b981256e33759d91bc2ee9b74a2bf633e013c0620b5\n      + 0xef9b6324ed493183babb66ed98fcf36e9bcb0243ae4c5a29fcd99184b08f1899\n      + 0xe6bbd6277e1bf288eed5e8d1780f9a50b239e86b153736bceebccf4ea79d90b3\n      + word(1050)\n      + word(nonce)\n      + word(intentExpiry)\n      + 0xee62665949c883f9e0f6f002eac32e00bd59dfe6c34e92a91c37d6a8322d6489\n      + word(price)\n      + word(time)\n      + 0xf5a695b63ab16fd8278cb1cf7d29f274a9574b64e0b894750e08c990fc8891bc;\n    bytes32 message = bytes32(digest(\n      0x1901\n        + 0xf57d55f057fd4aba6b1a7f8bccb6a3e826cf71fd34971f22a39d7ffd6e620fb3\n        + bytes32(digest(body, 4)),\n      4\n    ));\n    require(checkSigFromStack(sig, 0x100211ee120bca9f272034d98b1b026bb4ab735ebeb5da8be6a69bf7ee0ea24cfd48, message), \"dia\");\n\n    bytes prev = tx.inputs[0].packet(STATE);\n    bytes next = tx.packet(STATE);\n    require(size(prev) == SIZE, \"prev size\");\n    require(size(next) == SIZE, \"next size\");\n    require(substr(prev, 0, 1) == 0x01, \"prev version\");\n    require(substr(next, 0, 1) == 0x01, \"next version\");\n    int lastExpiry = bytes2int(substr(prev, SLOTS, 8));\n    require(expiry > lastExpiry, \"expiry order\");\n    absent(prev, expiry);\n    int round = bytes2int(substr(prev, 1, 8));\n    let attestMsg = sha256(\n      domain + \"attest\" + ctrlTxid + int2bytes(ctrlGidx, 4) + int2bytes(round, 8)\n        + int2bytes(expiry, 8) + int2bytes(cents, 8) + int2bytes(time, 8)\n    );\n    require(checkSigFromStack(adminSig, adminPk, attestMsg), \"oracle service\");\n    require(bytes2int(substr(next, 1, 8)) == round + 1, \"round\");\n    require(substr(next, SLOTS, 8) == int2bytes(expiry, 8), \"slot expiry\");\n    let slotValue = int2bytes(cents, 8) + int2bytes(time, 8) + int2bytes(0, 16);\n    require(substr(next, VALUE_AT, 32) == slotValue, \"slot value\");\n    require(substr(next, HISTORY_AT, HISTORY) == substr(prev, SLOTS, HISTORY), \"history\");\n    require(tx.outputs[0].value >= tx.input.current.value, \"value\");\n    continues(next);\n  }\n\n  @allow(unsigned-spend-path, \"permissionless read preserves state and pays readFee\")\n  function read(int selfIndex) {\n    require(selfIndex == this.activeInputIndex, \"self index\");\n    bytes state = tx.packet(STATE);\n    require(state == tx.inputs[selfIndex].packet(STATE), \"state carried\");\n    require(tx.outputs[0].value >= tx.input.current.value + readFee, \"read fee\");\n    continues(state);\n  }\n\n  @allow(unsigned-spend-path, \"authorized by adminPk checkSigFromStack over round and next script\")\n  function migrate(ScriptPubKey next, signature opSig) {\n    require(this.activeInputIndex == 0, \"beacon is input 0\");\n    bytes state = tx.packet(STATE);\n    require(state == tx.inputs[0].packet(STATE), \"state carried\");\n    require(size(state) == SIZE, \"state size\");\n    int round = bytes2int(substr(state, 1, 8));\n    let msg = sha256(domain + \"migrate\" + ctrlTxid + int2bytes(ctrlGidx, 4) + int2bytes(round, 8) + next.program);\n    require(checkSigFromStack(opSig, adminPk, msg), \"oracle service\");\n    require(tx.outputs[0].script == next, \"next script\");\n    require(tx.outputs[0].value >= tx.input.current.value, \"value\");\n    require(tx.outputs[0].assets.lookup(AssetId { txid: ctrlTxid, gidx: ctrlGidx }) == 1, \"identity asset\");\n  }\n\n  @allow(unsigned-spend-path, \"authorized by adminPk checkSigFromStack over VTXO outpoint for batch renewal\")\n  function reboard(signature opSig) {\n    require(tx.version == 2, \"intent only\");\n    bytes intentType = tx.intent.field(bytes(\"type\"));\n    require(intentType == bytes(\"register\") || intentType == bytes(\"delete\"), \"intent type\");\n    if (intentType == bytes(\"register\")) {\n      require(tx.intent.field(bytes(\"onchain_output_indexes\")) == bytes(\"[]\"), \"onchain output\");\n    }\n    require(this.activeInputIndex >= 1, \"intent input\");\n    let op = tx.input.current.outpoint;\n    let msg = sha256(domain + \"reboard\" + ctrlTxid + int2bytes(ctrlGidx, 4) + op.txid + int2bytes(op.vout, 4));\n    require(checkSigFromStack(opSig, adminPk, msg), \"oracle service\");\n    require(this.tunnel(this.activeInputIndex - 1), \"same position\");\n    require(tx.outputs[this.activeInputIndex - 1].assets.lookup(AssetId { txid: ctrlTxid, gidx: ctrlGidx }) == 1, \"identity asset\");\n  }\n\n  @allow(unsigned-spend-path, \"authorized by adminPk checkSigFromStack over outpoint, round, and lastExpiry when STATE packet is absent\")\n  function reseed(int round, int lastExpiry, signature opSig) {\n    require(this.activeInputIndex == 0, \"beacon is input 0\");\n    require(!tx.inputs[0].packet.has(STATE), \"already seeded\");\n    require(round >= 0, \"round\");\n    require(lastExpiry >= 0, \"expiry\");\n    require(lastExpiry % GRID == 0, \"expiry grid\");\n    let op = tx.input.current.outpoint;\n    let msg = sha256(\n      domain + \"reseed\" + ctrlTxid + int2bytes(ctrlGidx, 4)\n        + op.txid + int2bytes(op.vout, 4)\n        + int2bytes(round, 8) + int2bytes(lastExpiry, 8)\n    );\n    require(checkSigFromStack(opSig, adminPk, msg), \"oracle service\");\n    bytes next = tx.packet(STATE);\n    require(bytes2int(substr(next, 1, 8)) == round, \"round\");\n    require(substr(next, SLOTS, 8) == int2bytes(lastExpiry, 8), \"last expiry\");\n    require(substr(next, VALUE_AT, 32) == int2bytes(0, 32), \"empty value\");\n    require(substr(next, HISTORY_AT, HISTORY) == int2bytes(0, HISTORY), \"empty history\");\n    require(tx.outputs[0].value >= tx.input.current.value, \"value\");\n    continues(next);\n  }\n\n  function unilateral(signature adminSig) tapscript {\n    require(older(exit));\n    require(checkSig(adminSig, adminPk));\n  }\n}\n"
    }
  },
  "compiler": {
    "name": "arkadec",
    "version": "0.1.0",
    "options": {
      "optimize": true
    }
  },
