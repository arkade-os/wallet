{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "native-wallet",
  "description": "Card operations for the bundled wallet window",
  "windows": ["main"],
  "local": true,
  "permissions": [
    "core:default",
    "satochip:allow-connect",
    "satochip:allow-inspect",
    "satochip:allow-setup-card",
    "satochip:allow-get-public-key",
    "satochip:allow-sign-schnorr",
    "satochip:allow-sign-ecdsa",
    "satochip:allow-disconnect",
    "satochip:allow-status",
    "satochip:allow-presence",
    "satochip:allow-register-listener",
    "satochip:allow-remove-listener",
    "wallet:allow-secret-get",
    "wallet:allow-secret-set",
    "wallet:allow-secret-remove",
    "wallet:allow-clipboard-read",
    "wallet:allow-clipboard-write",
    "wallet:allow-share-text",
    "wallet:allow-initial-intent",
    "wallet:allow-set-back-handler",
    "wallet:allow-register-listener",
    "wallet:allow-remove-listener",
    "wallet:allow-background-status",
    "wallet:allow-configure-background",
    "wallet:allow-clear-background",
    "wallet:allow-export-backup",
    "wallet:allow-import-backup",
    "wallet-sql:allow-run",
    "wallet-sql:allow-all",
    "wallet-sql:allow-snapshot",
    "wallet-sql:allow-validate-snapshot",
    "wallet-sql:allow-restore"
  ]
}
